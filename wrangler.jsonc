{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beta",
  "compatibility_date": "2026-05-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true}
  },
  "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
